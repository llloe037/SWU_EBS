# .clineignore
# ไฟล์เหล่านี้จะไม่ถูกวิเคราะห์หรืออ่านโดย AI เพื่อความเป็นส่วนตัว ความปลอดภัย และประสิทธิภาพ

# Environment variables
.env
.env.*

# Python Virtual Environment
.venv/
venv/
env/
ENV/

# Python Cache & compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# SQL Database local
*.sqlite3
db.sqlite3

# Static & Media local directory
staticfiles/
media/
pickup_evidence/
return_evidence/

# VS Code & IDE settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Build and distributions
build/
dist/
*.egg-info/
.eggs/
*.egg

# OS files
.DS_Store
Thumbs.db
